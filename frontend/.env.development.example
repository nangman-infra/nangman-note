# Development environment variables
# Used for local development (`pnpm dev`)

# API 접속은 Next.js rewrite 프록시를 통해 same-origin으로 처리됩니다.
# NEXT_PUBLIC_API_URL=

# WebSocket URL (런타임 환경변수 — layout.tsx에서 window.__RUNTIME_ENV__로 주입)
# 개발 환경에서는 백엔드에 직접 연결합니다.
WS_URL=http://localhost:9999

# 백엔드 서버 주소 (Next.js 서버사이드 rewrite 전용, 브라우저에 노출 안됨)
BACKEND_URL=http://localhost:9999

NEXT_PUBLIC_APP_NAME=TransNote
NEXT_PUBLIC_APP_VERSION=1.0.0-dev

NEXT_PUBLIC_ENABLE_OFFLINE=false
NEXT_PUBLIC_AUTO_SAVE_DELAY=3000

# Auth.js + Authentik (OIDC)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-long-random-secret
AUTHENTIK_ISSUER=http://localhost:9000/application/o/transnote/
AUTHENTIK_CLIENT_ID=replace-with-client-id
AUTHENTIK_CLIENT_SECRET=replace-with-client-secret
