# Production environment variables

# API/WS 접속은 Next.js rewrite 프록시를 통해 same-origin으로 처리됩니다.
# 프로덕션에서는 리버스 프록시(nginx/ALB)가 /api/*, /ws/* 라우팅을 담당합니다.
# NEXT_PUBLIC_API_URL=
# NEXT_PUBLIC_WS_URL=

# 백엔드 서버 주소 (Next.js 서버사이드 rewrite 전용, 브라우저에 노출 안됨)
BACKEND_URL=http://backend-service:9999

NEXT_PUBLIC_APP_NAME=TransNote
NEXT_PUBLIC_APP_VERSION=1.0.0

NEXT_PUBLIC_ENABLE_OFFLINE=false
NEXT_PUBLIC_AUTO_SAVE_DELAY=3000
