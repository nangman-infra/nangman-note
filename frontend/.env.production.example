# Production environment variables

# API 접속은 Next.js rewrite 프록시를 통해 same-origin으로 처리됩니다.
# 프로덕션에서는 리버스 프록시(nginx/ALB)가 /api/* 라우팅을 담당합니다.
# NEXT_PUBLIC_API_URL=

# WebSocket URL (런타임 환경변수 — layout.tsx에서 window.__RUNTIME_ENV__로 주입)
# 프로덕션에서는 리버스 프록시 경유 → /ws/ → 백엔드
# 빈 문자열이면 same-origin으로 연결됩니다.
WS_URL=https://app.example.com

# 백엔드 서버 주소 (Next.js 서버사이드 rewrite 전용, 브라우저에 노출 안됨)
BACKEND_URL=http://backend-service:9999

NEXT_PUBLIC_APP_NAME=TransNote
NEXT_PUBLIC_APP_VERSION=1.0.0

NEXT_PUBLIC_ENABLE_OFFLINE=false
NEXT_PUBLIC_AUTO_SAVE_DELAY=3000

# ─── Auth.js + Authentik (OIDC) ───
# NEXTAUTH_URL: 이 앱이 배포된 URL (Authentik URL이 아님!)
NEXTAUTH_URL=https://app.example.com

# NEXTAUTH_SECRET: JWT 세션 암호화 키 (생성: openssl rand -base64 32)
NEXTAUTH_SECRET=replace-with-long-random-secret

# AUTHENTIK_ISSUER: Authentik OIDC Issuer URL
AUTHENTIK_ISSUER=https://auth.example.com/application/o/transnote/

# AUTHENTIK_CLIENT_ID / CLIENT_SECRET: Authentik Provider에서 복사
AUTHENTIK_CLIENT_ID=replace-with-client-id
AUTHENTIK_CLIENT_SECRET=replace-with-client-secret

# Authentik Provider Redirect URI:
#   {NEXTAUTH_URL}/api/auth/callback/authentik
