# ========================================
# TransNote 루트 .gitignore
# ========================================

# Dependencies
node_modules/

# OS
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.sublime-workspace
*.sublime-project
.project
.classpath
.c9/
*.launch
.settings/

# Logs
logs/
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# Environment variables
.env
.env.local
.env.*.local

# Tests
coverage/
.nyc_output/

# Temp files
*.tmp
*.temp

# ========================================
# Backend (Nest.js)
# ========================================
backend/dist/
backend/data/*.db
backend/data/*.db-journal

# ========================================
# Frontend (Next.js)
# ========================================
frontend/.next/
frontend/out/
frontend/build/
frontend/.vercel
frontend/*.tsbuildinfo
frontend/next-env.d.ts
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Misc
*.pem