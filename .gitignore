# ========================================
# TransNote 루트 .gitignore
# ========================================

# Infrastructure (ECS task definitions - local only)
infra/

# Scripts (local deployment/utility scripts)
scripts/

# Dependencies
node_modules/

# OS
.DS_Store
Thumbs.db

# IDE / AI tools
.idea/
.vscode/
.kiro/
*.sublime-workspace
*.sublime-project
.project
.classpath
.c9/
*.launch
.settings/

# Logs
logs/
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# Environment variables
.env
.env.secrets
.env.development
.env.production
.env.local
.env.*.local
backend/.env
backend/.env.development
backend/.env.production
frontend/.env
frontend/.env.development
frontend/.env.production

# Tests
coverage/
.nyc_output/

# Temp files
*.tmp
*.temp

# Local working notes (작업 메모)
scratchpad.md

# ========================================
# Backend (Nest.js)
# ========================================
dist/
**/dist/
backend/dist/
backend/data/*.db
backend/data/*.db-journal

# ========================================
# Frontend (Next.js)
# ========================================
frontend/.next/
frontend/out/
frontend/build/
frontend/.vercel
frontend/*.tsbuildinfo
frontend/next-env.d.ts
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Misc
*.pem
