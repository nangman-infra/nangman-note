# Server Configuration
PORT=9999
NODE_ENV=development

# Database Configuration
# 개발 기본: 파일 기반 SQLite(sqljs)
DB_ENGINE=sqljs
DB_MIGRATIONS_RUN=false
DB_PATH=./data/dev.db

# PostgreSQL 로컬 검증 시에만 사용 (DB_ENGINE=postgres 로 전환)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=nangman_note
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_SSL=false
# DB_SSL_REJECT_UNAUTHORIZED=false
# DB_POOL_MAX=10
# DB_CONNECTION_TIMEOUT_MS=5000
# DB_IDLE_TIMEOUT_MS=30000
# DB_STATEMENT_TIMEOUT_MS=15000

# Encryption Configuration
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=dev-only-encryption-key-replace-in-production

# AWS Configuration
AWS_REGION=ap-northeast-2
AWS_PROFILE=your-aws-profile-name
AWS_TRANSCRIBE_JOB_PREFIX=nangman-note-dev
AWS_TRANSCRIBE_LANGUAGE_CODE=ko-KR
AWS_TRANSCRIBE_OUTPUT_BUCKET=your-s3-bucket-name
AWS_TRANSCRIBE_MEDIA_FORMAT=webm
# Speaker diarization (Amazon Transcribe range: 2-10)
AWS_TRANSCRIBE_MAX_SPEAKER_LABELS=8
# Custom Vocabulary (optional, leave empty to disable)
# AWS_TRANSCRIBE_VOCABULARY_NAME=

# S3 Audio Configuration
AWS_S3_AUDIO_BUCKET=your-s3-bucket-name
AWS_S3_AUDIO_KEY_PREFIX=meeting-audio

# Bedrock Configuration
AWS_BEDROCK_MODEL_ID=apac.amazon.nova-pro-v1:0
AWS_BEDROCK_MAX_TOKENS=4096
AWS_BEDROCK_TEMPERATURE=0.2

# Realtime Transcription Flow Control
REALTIME_MAX_CONCURRENT_SESSIONS=8
REALTIME_MAX_BUFFERED_AUDIO_BYTES=4194304
REALTIME_MAX_AUDIO_CHUNK_BYTES=65536
REALTIME_BACKPRESSURE_RETRY_MS=200

# ─── Authentication (Authentik OIDC) ───
# AUTH_ENABLED: false면 인증 없이 동작 (개발 시 편의)
# true로 전환하면 모든 HTTP 요청에 Bearer 토큰 필요
AUTH_ENABLED=false

# AUTH_OIDC_ISSUER: Authentik OIDC Issuer URL (프론트의 AUTHENTIK_ISSUER와 동일)
# AUTH_OIDC_AUDIENCE: Authentik Client ID와 동일한 값
# AUTH_OIDC_JWKS_URI: 빈 문자열이면 issuer/.well-known/jwks.json에서 자동 유추
AUTH_OIDC_ISSUER=
AUTH_OIDC_AUDIENCE=
AUTH_OIDC_JWKS_URI=

# Logging Configuration
LOG_LEVEL=debug

# CORS Configuration (comma-separated)
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
