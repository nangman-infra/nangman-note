# Server Configuration
PORT=9999
NODE_ENV=production

# Database Configuration (production: PostgreSQL only)
DB_ENGINE=postgres
DB_MIGRATIONS_RUN=true
DB_HOST=replace-with-rds-endpoint
DB_PORT=5432
DB_NAME=nangman_note
DB_USER=replace-with-app-user
DB_PASSWORD=replace-with-app-password
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=true
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=30000
DB_STATEMENT_TIMEOUT_MS=15000

# Encryption Configuration (must be overridden with a secure value)
ENCRYPTION_KEY=replace-with-64-char-hex-key

# AWS Configuration
AWS_REGION=ap-northeast-2
AWS_PROFILE=default
AWS_TRANSCRIBE_JOB_PREFIX=nangman-note-prod
AWS_TRANSCRIBE_LANGUAGE_CODE=ko-KR
AWS_TRANSCRIBE_OUTPUT_BUCKET=replace-with-output-bucket
AWS_TRANSCRIBE_MEDIA_FORMAT=webm
# Speaker diarization (Amazon Transcribe range: 2-10)
AWS_TRANSCRIBE_MAX_SPEAKER_LABELS=8
# Custom Vocabulary (optional, leave empty to disable)
# AWS_TRANSCRIBE_VOCABULARY_NAME=

# S3 Audio Configuration
AWS_S3_AUDIO_BUCKET=replace-with-audio-bucket
AWS_S3_AUDIO_KEY_PREFIX=meeting-audio

# Bedrock Configuration
AWS_BEDROCK_MODEL_ID=apac.amazon.nova-pro-v1:0
AWS_BEDROCK_MAX_TOKENS=4096
AWS_BEDROCK_TEMPERATURE=0.2

# Realtime Transcription Flow Control
REALTIME_MAX_CONCURRENT_SESSIONS=8
# Optional override. Omit to auto-compute from container CPU/memory.
# PLAYWRIGHT_PDF_MAX_CONCURRENT_RENDERS=2
REALTIME_MAX_BUFFERED_AUDIO_BYTES=4194304
REALTIME_MAX_AUDIO_CHUNK_BYTES=65536
REALTIME_BACKPRESSURE_RETRY_MS=200

# ─── Authentication (Authentik OIDC) ───
# AUTH_ENABLED: 운영에서는 반드시 true
AUTH_ENABLED=true

# AUTH_OIDC_ISSUER: Authentik OIDC Issuer URL
AUTH_OIDC_ISSUER=https://auth.example.com/application/o/transnote/

# AUTH_OIDC_AUDIENCE: Authentik Client ID와 동일한 값
AUTH_OIDC_AUDIENCE=replace-with-authentik-client-id

# AUTH_OIDC_JWKS_URI: 빈 문자열이면 OIDC discovery(issuer/.well-known/openid-configuration)의
# jwks_uri 를 사용. discovery 를 못 읽으면 인증은 실패(fail-closed)하며 5초 후 재시도한다.
# 운영에서는 명시 권장. Authentik: https://auth.example.com/application/o/transnote/jwks/
AUTH_OIDC_JWKS_URI=

# AUTH_OIDC_ALGORITHMS: 허용 서명 알고리즘(콤마 구분, 비대칭만). Authentik 기본 RS256
AUTH_OIDC_ALGORITHMS=RS256

# TRUST_PROXY: Express trust proxy. 같은 호스트의 리버스 프록시(NPM, Next.js)만 신뢰 = loopback
TRUST_PROXY=loopback

# Logging Configuration
LOG_LEVEL=info

# CORS Configuration (comma-separated)
CORS_ORIGIN=https://app.example.com
